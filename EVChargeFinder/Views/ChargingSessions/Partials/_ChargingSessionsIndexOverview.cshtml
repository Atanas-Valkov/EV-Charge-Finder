@model EVChargeFinder.ViewModels.ChargingSessions.ChargingSessionsIndexViewModel

<section class="sessions-overview">
    <div class="row g-3">
        <div class="col-12 col-xl-9">
            <div class="sessions-panel h-100">
                <div class="sessions-panel-header sessions-overview-toolbar">
                    <h2>Overview</h2>

                    <div class="sessions-period-control">
                        <svg class="sessions-period-icon"
                             width="16"
                             height="16"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.6"
                             aria-hidden="true">
                            <rect x="3"
                                  y="5"
                                  width="18"
                                  height="16"
                                  rx="2" />
                            <path d="M16 3v4M8 3v4M3 11h18" />
                            <path d="M7 15h2M11 15h2M15 15h2M7 18h2M11 18h2" />
                        </svg>

                        <label for="periodFilter"
                               class="visually-hidden">
                            Chart period
                        </label>
						
                        <div class="sessions-period-filter dropdown">
	                        <input type="hidden"
	                               id="periodFilter"
	                               name="period"
                                   value="month" />

	                        <button class="sessions-period-button dropdown-toggle"
	                                type="button"
	                                data-bs-toggle="dropdown"
	                                aria-expanded="false">

		                        <i class="bi bi-calendar3"></i>

		                        <span id="periodFilterText">
			                        Last 30 days
		                        </span>
	                        </button>

	                        <ul class="dropdown-menu sessions-period-menu">
		                        <li>
			                        <button class="dropdown-item"
			                                type="button"
                                            data-period="week">
				                        Last 7 days
			                        </button>
		                        </li>

		                        <li>
			                        <button class="dropdown-item active"
			                                type="button"
			                                data-period="month">
				                        Last 30 days
			                        </button>
		                        </li>

		                        <li>
			                        <button class="dropdown-item"
			                                type="button"
			                                data-period="year">
				                        Last 12 months
			                        </button>
		                        </li>
	                        </ul>
                        </div>
                       
                    </div>
                </div>

                <partial name="~/Views/ChargingSessions/Partials/_ChargingSessionsIndexMetrics.cshtml"
                         model="Model" />

                <partial name="~/Views/ChargingSessions/Partials/_ChargingSessionsIndexChart.cshtml"
                         model="Model.DailyEnergy" />
            </div>
        </div>

        <div class="col-12 col-xl-3">
            <partial name="~/Views/ChargingSessions/Partials/_ChargingSessionsIndexMostUsedConnectors.cshtml"
                     model="Model.MostUsedConnectors" />
        </div>
    </div>
</section>