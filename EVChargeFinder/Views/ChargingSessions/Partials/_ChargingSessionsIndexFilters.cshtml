@model ChargingSessionsIndexViewModel

@{
    bool hasFilters = Model.From.HasValue || Model.To.HasValue;
}

<form asp-controller="ChargingSessions" asp-action="Index" method="get" class="sessions-filters">

    <div class="d-flex flex-wrap gap-2 mb-3">

        <label for="sessions-search" class="visually-hidden">Search by station name</label>

        <input id="sessions-search"
               name="searchTerm"
               value="@Model.SearchTerm"
               type="search"
               class="form-control flex-grow-1 w-auto"
               placeholder="Search by station name..." />

        <button type="submit" class="btn btn-primary">Search</button>

        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-toggle="collapse"
                data-bs-target="#sessions-filter-options"
                aria-expanded="@(hasFilters ? "true" : "false")"
                aria-controls="sessions-filter-options">
            Filters
        </button>

    </div>

    <div class="collapse @(hasFilters ? "show" : "")" id="sessions-filter-options">

        <div class="row g-3 mb-3">

            <div class="col-12 col-md-6 col-xl-6">

                <label for="sessions-from" class="form-label">From</label>

                <input id="sessions-from"
                       name="from"
                       type="date"
                       value="@(Model.From?.ToString("yyyy-MM-dd"))"
                       class="form-control" />

            </div>

            <div class="col-12 col-md-6 col-xl-6">

                <label for="sessions-to" class="form-label">To</label>

                <input asp-for="To"
                       id="sessions-to"
                       type="date"
                       asp-format="{0:yyyy-MM-dd}"
                       class="form-control" />

                <span asp-validation-for="To" class="text-danger d-block mt-1"></span>

            </div>

        </div>

    </div>

</form>
