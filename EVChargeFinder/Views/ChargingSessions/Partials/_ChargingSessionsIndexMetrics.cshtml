@model EVChargeFinder.ViewModels.ChargingSessions.ChargingSessionsIndexViewModel

<div class="row g-3 sessions-metrics mb-4">

	<div class="col-6 col-md-3">
		<div class="sessions-metric">

			<div class="sessions-metric-icon sessions-metric-icon-blue">
				<svg viewBox="0 0 24 24"
					 fill="none"
					 stroke="currentColor"
					 stroke-width="1.8"
					 stroke-linecap="round"
					 stroke-linejoin="round"
					 aria-hidden="true">
					<rect x="5" y="3" width="14" height="18" rx="2" />
					<path d="M9 7h6" />
					<path d="M9 11h6" />
					<path d="M9 15h4" />
				</svg>
			</div>

			<div class="sessions-metric-content">
				<span class="sessions-metric-label d-block">
					Sessions
				</span>

				<strong class="sessions-metric-value">
					@Model.SessionsCount.ToString("N0")
				</strong>
			</div>

		</div>
	</div>


	<div class="col-6 col-md-3">
		<div class="sessions-metric">

			<div class="sessions-metric-icon sessions-metric-icon-green">
				<svg viewBox="0 0 24 24"
					 fill="none"
					 stroke="currentColor"
					 stroke-width="1.8"
					 stroke-linecap="round"
					 stroke-linejoin="round"
					 aria-hidden="true">
					<path d="M13 2L6 13h5l-1 9 8-12h-5V2z" />
				</svg>
			</div>

			<div class="sessions-metric-content">
				<span class="sessions-metric-label d-block">
					Energy
				</span>

				<strong class="sessions-metric-value">
					@Model.TotalEnergyKWh.ToString("N2")
					<small>kWh</small>
				</strong>
			</div>

		</div>
	</div>


	<div class="col-6 col-md-3">
		<div class="sessions-metric">

			<div class="sessions-metric-icon sessions-metric-icon-purple">
				<svg viewBox="0 0 24 24"
					 fill="none"
					 stroke="currentColor"
					 stroke-width="1.8"
					 stroke-linecap="round"
					 stroke-linejoin="round"
					 aria-hidden="true">
					<rect x="3" y="6" width="18" height="12" rx="2" />
					<path d="M3 10h18" />
					<path d="M16 14h2" />
				</svg>
			</div>

			<div class="sessions-metric-content">
				<span class="sessions-metric-label d-block">
					Total Cost
				</span>

				<strong class="sessions-metric-value">
					@($"€ {Model.TotalCost:F2}")
				</strong>
			</div>

		</div>
	</div>


	<div class="col-6 col-md-3">
		<div class="sessions-metric">

			<div class="sessions-metric-icon sessions-metric-icon-orange">
				<svg viewBox="0 0 24 24"
					 fill="none"
					 stroke="currentColor"
					 stroke-width="1.8"
					 stroke-linecap="round"
					 stroke-linejoin="round"
					 aria-hidden="true">
					<circle cx="12" cy="12" r="9" />
					<path d="M12 7v5l3 2" />
				</svg>
			</div>

			<div class="sessions-metric-content">
				<span class="sessions-metric-label d-block">
					Average Duration
				</span>

				<strong class="sessions-metric-value">
					@if (Model.AverageDuration is TimeSpan duration)
					{
						<span>@((int)duration.TotalHours)h @(duration.Minutes)m</span>
					}
					else
					{
						<span>N/A</span>
					}
				</strong>
			</div>

		</div>
	</div>

</div>