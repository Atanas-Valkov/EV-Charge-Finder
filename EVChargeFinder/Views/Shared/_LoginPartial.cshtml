@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
	string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

	bool isRegisterActive = currentPage == "/Account/Register";
	bool isLoginActive = currentPage == "/Account/Login";
	bool isManageActive = currentPage.StartsWith(
		"/Account/Manage/",
		StringComparison.OrdinalIgnoreCase);
}

<ul class="navbar-nav">
	@if (SignInManager.IsSignedIn(User))
	{
		<li class="nav-item">
			<a class="nav-link app-nav-link @(isManageActive ? "active" : "")"
			   asp-area="Identity"
			   asp-page="/Account/Manage/Index"
			   aria-current="@(isManageActive ? "page" : null)"
			   title="Manage">
				Hello @User.Identity?.Name!
			</a>
		</li>

		<li class="nav-item">
			<form class="d-flex"
			      asp-area="Identity"
			      asp-page="/Account/Logout"
			      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

				<button type="submit"
				        class="nav-link btn btn-link app-nav-link">
					Logout
				</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link app-nav-link @(isRegisterActive ? "active" : "")"
			   asp-area="Identity"
			   asp-page="/Account/Register"
			   aria-current="@(isRegisterActive ? "page" : null)">
				Register
			</a>
		</li>

		<li class="nav-item">
			<a class="nav-link app-nav-link @(isLoginActive ? "active" : "")"
			   asp-area="Identity"
			   asp-page="/Account/Login"
			   aria-current="@(isLoginActive ? "page" : null)">
				Login
			</a>
		</li>
	}
</ul>