@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool isHomeActive = currentController == "Home" && currentAction == "Index";
    bool isPrivacyActive = currentController == "Home" && currentAction == "Privacy";
    bool isStationsActive = currentController == "ChargingStations";
    bool isSessionsActive = currentController == "ChargingSessions";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EVChargeFinder</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EVChargeFinder.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar mb-3">
            <div class="container-fluid">

                <a class="navbar-brand app-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i>
                    EVChargeFinder
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMainMenu"
                        aria-controls="navbarMainMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="navbarMainMenu"
                     class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(isHomeActive ? "active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               aria-current="@(isHomeActive ? "page" : null)">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(isStationsActive ? "active" : "")"
                               asp-area=""
                               asp-controller="ChargingStations"
                               asp-action="Index"
                               aria-current="@(isStationsActive ? "page" : null)">
                                Charging Stations
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(isSessionsActive ? "active" : "")"
                               asp-area=""
                               asp-controller="ChargingSessions"
                               asp-action="Index"
                               aria-current="@(isSessionsActive ? "page" : null)">
                                Charging Sessions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(isPrivacyActive ? "active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy"
                               aria-current="@(isPrivacyActive ? "page" : null)">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer app-footer">
        <div class="container">
            &copy; 2026 - EVChargeFinder -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
