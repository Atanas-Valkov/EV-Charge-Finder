@model IEnumerable<EVChargeFinder.DbModels.ChargingStation>
@using System.Text.Json
@using EVChargeFinder.DbModels.Enums
@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Charging Stations";

	var stations = Model?.ToArray()
	               ?? Array.Empty<EVChargeFinder.DbModels.ChargingStation>();

	int stationsCount = stations.Length;


	int activeStationsCount = stations
		.Count(cs => cs.ChargingStationStatus.ToString() == "Active");

	int operatorsCount = stations
		.Where(cs => cs.Operator != null)
		.Select(cs => cs.Operator!.Id)
		.Distinct()
		.Count();

	int connectorsCount = stations
		.Sum(cs => cs.Connectors.Count);


	var mapStations = stations.Select(station =>
	{
		string[] connectorTypes = station.Connectors
			.Select(c => c.ConnectorType.ToString())
			.ToArray();

		bool hasAc = connectorTypes.Any(type =>
			type == "Type1" ||
			type == "Type2" ||
			type == "Schuko" ||
			type == "GB_T_AC");

		bool hasDc = connectorTypes.Any(type =>
			type == "CCS1" ||
			type == "CCS2" ||
			type == "CHAdeMO" ||
			type == "NACS" ||
			type == "GB_T_DC");

		string chargingType;

		if (hasAc && hasDc)
		{
			chargingType = "AC/DC";
		}
		else if (hasDc)
		{
			chargingType = "DC";
		}
		else if (hasAc)
		{
			chargingType = "AC";
		}
		else
		{
			chargingType = "N/A";
		}

		decimal maxPowerKw = station.Connectors.Any()
			? station.Connectors.Max(c => c.PowerKw)
			: 0m;

		return new
		{
			station.Id,
			station.Name,
			station.City,
			station.Address,
			station.Latitude,
			station.Longitude,

			Operator = station.Operator != null
				? station.Operator.Name
				: "N/A",

			ChargingType = chargingType,
			MaxPowerKw = maxPowerKw
		};
	});

	string stationsJson = JsonSerializer.Serialize(mapStations);
}


