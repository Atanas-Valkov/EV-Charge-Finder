@model ChargingStationsIndexViewModel
@using System.Text.Json

@{
	ViewData["Title"] = "Charging Stations";

	var mapStations = Model.Stations
		.Select(station => new
		{
			station.Id,
			station.Name,
			station.City,
			station.Address,
			station.Latitude,
			station.Longitude,
			Operator = station.OperatorName,
			station.ChargingType,
			station.MaxPowerKw
		});

	string stationsJson = JsonSerializer.Serialize(mapStations);
}

@section Styles
{
	<link rel="stylesheet"
	      href="~/css/charging-stations-index.css"
	      asp-append-version="true" />
}

<div class="container stations-page">

<!-- =========================================PAGE HEADER========================================== -->

<div class="stations-header">

	<div class="row align-items-center">

		<div class="col-md-8">

			<h1 class="stations-title">
				Charging Stations
			</h1>

			<p class="stations-subtitle">
				Find and explore electric vehicle charging stations
			</p>

		</div>

	</div>

</div>


<!-- =========================================DASHBOARD METRICS========================================== -->

<partial name="Partials/_ChargingStationsMetrics"
         model="Model" />

<partial name="Partials/_ChargingStationsFilters"
         model="Model" />

<!-- =========================================MAP========================================== -->

<partial name="Partials/_ChargingStationsMap" />

<!-- ==============================STATIONS LIST ========================================== -->

<partial name="Partials/_ChargingStationsList"
         model="Model" />

</div> <!-- close .container stations-page -->

<script id="stationsData" type="application/json">
    @Html.Raw(stationsJson)
</script>


@section Scripts
{
	<script src="~/js/charging-stations-index.js"
	        asp-append-version="true">
    </script>
}