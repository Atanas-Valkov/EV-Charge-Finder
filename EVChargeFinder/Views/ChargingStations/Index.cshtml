	{
		<div class="empty-stations">

			<i class="bi bi-ev-station"></i>

			<h5>
				No charging stations found
			</h5>

			<p class="mb-0">
				There are currently no stations available.
			</p>

		</div>
	}
	else
	{
		<div class="table-responsive">

			<table class="table stations-table">

				<thead>

				<tr>

					<th>
						Name
					</th>

					<th>
						Operator
					</th>

					<th>
						City
					</th>

					<th>
						Address
					</th>

					<th>
						Status
					</th>

				</tr>

				</thead>


				<tbody>

				@foreach (var station in stations)
				{
					<tr>

						<td>

							<a asp-controller="ChargingStations"
							   asp-action="Details"
							   asp-route-id="@station.Id"
							   class="station-name-link">
								@station.Name
							</a>

						</td>


						<td>

							@if (station.Operator != null)
							{
								<span class="operator-name">
									@station.Operator.Name
								</span>
							}
							else
							{
								<span class="text-muted">
									N/A
								</span>
							}

						</td>


						<td>

							@if (!string.IsNullOrWhiteSpace(station.City))
							{
								<span class="city-name">
									@station.City
								</span>
							}
							else
							{
								<span class="text-muted">
									N/A
								</span>
							}

						</td>


						<td>

							<span class="station-address">
								@station.Address
							</span>

						</td>


						<td>

							@if (station.ChargingStationStatus.ToString() == "Active")
							{
								<span class="status-badge status-active">

									<span class="status-dot"></span>

									Active

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "Inactive")
							{
								<span class="status-badge status-inactive">

									<span class="status-dot"></span>

									Inactive

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "PartiallyAvailable")
							{
								<span class="status-badge status-partial">

									<span class="status-dot"></span>

									Partially Available

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "Unavailable")
							{
								<span class="status-badge status-unavailable">

									<span class="status-dot"></span>

									Unavailable

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "Maintenance")
							{
								<span class="status-badge status-maintenance">

									<span class="status-dot"></span>

									Maintenance

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "Faulted")
							{
								<span class="status-badge status-faulted">

									<span class="status-dot"></span>

									Faulted

								</span>
							}

							else if (station.ChargingStationStatus.ToString() == "Offline")
							{
								<span class="status-badge status-offline">

									<span class="status-dot"></span>

									Offline

								</span>
							}

							else
							{
								<span class="status-badge status-unknown">

									<span class="status-dot"></span>

									Unknown

								</span>
							}

						</td>

					</tr>
				}

				</tbody>

			</table>

		</div>
	}

</div>


</div>


@section Scripts
{
	<script>

const stations = @Html.Raw(stationsJson);

const map = L.map('stationsMap')
    .setView(
        [
            42.7339,
            25.4858
        ],  
        7
    );


       
const mapboxToken = '@Configuration["Mapbox:AccessToken"]';

L.tileLayer(
    `https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/512/{z}/{x}/{y}?access_token=${mapboxToken}`,
    {
        tileSize: 512,
        zoomOffset: -1,
        maxZoom: 22,
        attribution: '© Mapbox © OpenStreetMap'
    })
    .addTo(map);

        stations.forEach(station => {


const locateButton = document.getElementById('locateUserButton');

let userLocationMarker = null;

locateButton.addEventListener('click', function () {

    navigator.geolocation.getCurrentPosition(
        function (position) {

            const userLatitude = position.coords.latitude;
            const userLongitude = position.coords.longitude;

            if (userLocationMarker === null) {

                userLocationMarker = L.marker([
                    userLatitude,
                    userLongitude
                ])
                .addTo(map)
                .bindPopup('Your location');

            }
            else {

                userLocationMarker.setLatLng([
                    userLatitude,
                    userLongitude
                ]);

            }

            map.flyTo(
                [
                    userLatitude,
                    userLongitude
                ],
                14
            );

            userLocationMarker.openPopup();
        },
        function (error) {

            console.log(error);

        }
    );

});


            /* -----------------------------
               Pin color
            ----------------------------- */

            let pinColor = "#6c757d";


            if (station.ChargingType === "AC") {

                pinColor = "#2ecc71";

            }
            else if (station.ChargingType === "DC") {

                pinColor = "#f59e0b";

            }
            else if (station.ChargingType === "AC/DC") {

                pinColor = "#0d6efd";

            }


            /* -----------------------------
               Power text
            ----------------------------- */

            const powerValue =
                Number(station.MaxPowerKw);


            const displayPower =
                Number.isInteger(powerValue)
                    ? powerValue.toString()
                    : powerValue.toFixed(1);


            /* -----------------------------
               AC / DC text
            ----------------------------- */

            const typeFontSize =
                station.ChargingType === "AC/DC"
                    ? 11
                    : 13;


            const chargingTypeText =
                station.ChargingType === "AC/DC"
                    ? `
                        <tspan
                            x="30"
                            y="50">
                            AC
                        </tspan>

                        <tspan
                            x="30"
                            y="61">
                            DC
                        </tspan>
                      `
                    : `
                        <tspan
                            x="30"
                            y="56">
                            ${station.ChargingType}
                        </tspan>
                      `;


            /* -----------------------------
               Custom SVG marker
            ----------------------------- */

            const stationIcon = L.divIcon({

                className:
                    'charging-station-marker',

                html: `
                    <svg
                        width="60"
                        height="82"
                        viewBox="0 0 60 82"
                        xmlns="http://www.w3.org/2000/svg">


                        <defs>

                            <filter
                                id="pinShadow-${station.Id}"
                                x="-40%"
                                y="-30%"
                                width="180%"
                                height="190%">

                                <feDropShadow
                                    dx="2"
                                    dy="3"
                                    stdDeviation="2"
                                    flood-color="#000"
                                    flood-opacity="0.45"/>

                            </filter>

                        </defs>


                        <path
                            d="
                                M 30 2
                                C 14 2, 4 13, 4 28
                                C 4 40, 10 48, 16 56
                                L 30 79
                                L 44 56
                                C 50 48, 56 40, 56 28
                                C 56 13, 46 2, 30 2
                                Z
                            "
                            fill="#171717"
                            filter="url(#pinShadow-${station.Id})"
                        />


                        <circle
                            cx="30"
                            cy="27"
                            r="21"
                            fill="${pinColor}"
                        />


                        <circle
                            cx="30"
                            cy="27"
                            r="17"
                            fill="#eeeeea"
                        />


                        <text
                            x="30"
                            y="24"
                            text-anchor="middle"
                            dominant-baseline="middle"
                            font-size="12"
                            font-weight="900"
                            fill="#202020">

                            ${displayPower}

                        </text>


                        <text
                            x="30"
                            y="35"
                            text-anchor="middle"
                            dominant-baseline="middle"
                            font-size="7"
                            font-weight="800"
                            fill="#333333">

                            kW

                        </text>


                        <text
                            x="30"
                            text-anchor="middle"
                            dominant-baseline="middle"
                            font-size="${typeFontSize}"
                            font-weight="900"
                            fill="#ffffff">

                            ${chargingTypeText}

                        </text>


                    </svg>
                `,

                iconSize:
                    [
                        60,
                        82
                    ],

                iconAnchor:
                    [
                        30,
                        79
                    ],

                popupAnchor:
                    [
                        0,
                        -76
                    ]
            });


            const marker = L.marker(
                [
                    station.Latitude,
                    station.Longitude
                ],
                {
                    icon: stationIcon
                }
            );


            marker.addTo(map);


            marker.bindPopup(`
                <div style="min-width: 210px;">

                    <strong
                        style="
                            font-size: 14px;
                            color: #172033;
                        ">
                        ${station.Name}
                    </strong>

                    <br>

                    <span
                        style="
                            color: #64748b;
                            font-size: 12px;
                        ">
                        ${station.Operator}
                    </span>

                    <br><br>

                    ${station.City ?? ""}

                    <br>

                    ${station.Address}

                    <br><br>

                    <strong>
                        ${station.ChargingType}
                        ·
                        ${displayPower} kW
                    </strong>

                    <br><br>

                    <a href="/ChargingStations/Details/${station.Id}">
                        View details
                    </a>

                </div>
            `);

        });

    </script>
}