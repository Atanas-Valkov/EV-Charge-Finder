@model ChargingStationsIndexViewModel
@using EVChargeFinder.DbModels.Enums

@{
	string selectedCityText = string.IsNullOrWhiteSpace(Model.SelectedCity)
		? "All cities"
		: Model.SelectedCity;

	string selectedStatusText = Model.SelectedStatus.HasValue
		? Model.SelectedStatus.Value.ToString()
		: "All statuses";

	string selectedOperatorText = Model.SelectedOperatorId.HasValue
		? Model.Operators
			.FirstOrDefault(op => op.Id == Model.SelectedOperatorId.Value)?.Name
			?? "All operators"
		: "All operators";

	string selectedConnectorText = Model.SelectedConnectorType.HasValue
		? Model.SelectedConnectorType.Value.ToString()
		: "All connector types";
}

<form asp-controller="ChargingStations"
	  asp-action="Search"
	  method="get">

	<div class="stations-search">
		<div class="stations-search-box">

			<i class="bi bi-search stations-search-icon"></i>

			<input type="search"
				   name="searchTerm"
				   value="@Model.SearchTerm"
				   class="stations-search-input"
				   placeholder="Search station, city, address or operator..." />

			<button type="submit"
					class="stations-search-button">
				Search
			</button>

		</div>
	</div>


	<div class="row g-3 filters-row">

		<div class="col-md-6 col-xl-3">
			<div class="filter-card">

				<label class="filter-label">
					<i class="bi bi-geo-alt"></i>
					City
				</label>

				<div class="dropdown dashboard-dropdown">

					<input type="hidden"
						   name="city"
						   value="@Model.SelectedCity" />

					<button type="button"
							class="dashboard-dropdown-button dropdown-toggle"
							data-bs-toggle="dropdown"
							aria-expanded="false">
						<span>@selectedCityText</span>
					</button>

					<ul class="dropdown-menu dashboard-dropdown-menu">

						<li>
							<button type="button"
									class="dropdown-item @(string.IsNullOrWhiteSpace(Model.SelectedCity) ? "active" : "")"
									data-filter-value="">
								All cities
							</button>
						</li>

						@foreach (string city in Model.Cities)
						{
							<li>
								<button type="button"
										class="dropdown-item @(Model.SelectedCity == city ? "active" : "")"
										data-filter-value="@city">
									@city
								</button>
							</li>
						}

					</ul>

				</div>

			</div>
		</div>


		<div class="col-md-6 col-xl-3">
			<div class="filter-card">

				<label class="filter-label">
					<i class="bi bi-activity"></i>
					Status
				</label>

				<div class="dropdown dashboard-dropdown">

					<input type="hidden"
						   name="status"
						   value="@Model.SelectedStatus" />

					<button type="button"
							class="dashboard-dropdown-button dropdown-toggle"
							data-bs-toggle="dropdown"
							aria-expanded="false">
						<span>@selectedStatusText</span>
					</button>

					<ul class="dropdown-menu dashboard-dropdown-menu">

						<li>
							<button type="button"
									class="dropdown-item @(!Model.SelectedStatus.HasValue ? "active" : "")"
									data-filter-value="">
								All statuses
							</button>
						</li>

						@foreach (ChargingStationStatus status
								  in Enum.GetValues<ChargingStationStatus>())
						{
							<li>
								<button type="button"
										class="dropdown-item @(Model.SelectedStatus == status ? "active" : "")"
										data-filter-value="@status">
									@status
								</button>
							</li>
						}

					</ul>

				</div>

			</div>
		</div>


		<div class="col-md-6 col-xl-3">
			<div class="filter-card">

				<label class="filter-label">
					<i class="bi bi-building"></i>
					Operator
				</label>

				<div class="dropdown dashboard-dropdown">

					<input type="hidden"
						   name="operatorId"
						   value="@Model.SelectedOperatorId" />

					<button type="button"
							class="dashboard-dropdown-button dropdown-toggle"
							data-bs-toggle="dropdown"
							aria-expanded="false">
						<span>@selectedOperatorText</span>
					</button>

					<ul class="dropdown-menu dashboard-dropdown-menu">

						<li>
							<button type="button"
									class="dropdown-item @(!Model.SelectedOperatorId.HasValue ? "active" : "")"
									data-filter-value="">
								All operators
							</button>
						</li>

						@foreach (var op in Model.Operators)
						{
							<li>
								<button type="button"
										class="dropdown-item @(Model.SelectedOperatorId == op.Id ? "active" : "")"
										data-filter-value="@op.Id">
									@op.Name
								</button>
							</li>
						}

					</ul>

				</div>

			</div>
		</div>


		<div class="col-md-6 col-xl-3">
			<div class="filter-card">

				<label class="filter-label">
					<i class="bi bi-plug"></i>
					Connector
				</label>

				<div class="dropdown dashboard-dropdown">

					<input type="hidden"
						   name="connectorType"
						   value="@Model.SelectedConnectorType" />

					<button type="button"
							class="dashboard-dropdown-button dropdown-toggle"
							data-bs-toggle="dropdown"
							aria-expanded="false">
						<span>@selectedConnectorText</span>
					</button>

					<ul class="dropdown-menu dashboard-dropdown-menu">

						<li>
							<button type="button"
									class="dropdown-item @(!Model.SelectedConnectorType.HasValue ? "active" : "")"
									data-filter-value="">
								All connector types
							</button>
						</li>

						@foreach (ConnectorType connectorType
								  in Enum.GetValues<ConnectorType>())
						{
							<li>
								<button type="button"
										class="dropdown-item @(Model.SelectedConnectorType == connectorType ? "active" : "")"
										data-filter-value="@connectorType">
									@connectorType
								</button>
							</li>
						}

					</ul>

				</div>

			</div>
		</div>

	</div>

</form>