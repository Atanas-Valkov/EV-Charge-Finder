@page
@model LogoutModel

@{
	ViewData["Title"] = "Log out";
}

<section class="identity-page">
	<div class="identity-card identity-card-center">

		@if (User.Identity?.IsAuthenticated ?? false)
		{
			<div class="identity-header">
				<div class="identity-icon">
					<i class="bi bi-box-arrow-right"></i>
				</div>

				<h1>Log Out</h1>
				<p>Are you sure you want to log out of your EVChargeFinder account?</p>
			</div>

			<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post">

				<button type="submit" class="btn identity-submit">
					<i class="bi bi-box-arrow-right"></i>
					Yes, Log Out
				</button>

			</form>

			<div class="identity-footer">
				<a asp-area="" asp-controller="Home" asp-action="Index">
					<i class="bi bi-arrow-left"></i>
					Cancel and Return Home
				</a>
			</div>
		}
		else
		{
			<div class="identity-header">
				<div class="identity-icon identity-icon-success">
					<i class="bi bi-check-circle"></i>
				</div>

				<h1>Successfully Logged Out</h1>
				<p>You have successfully logged out of EVChargeFinder.</p>
			</div>

			<a asp-area="" asp-controller="Home" asp-action="Index" class="btn identity-submit">
				<i class="bi bi-house"></i>
				Return Home
			</a>
		}

	</div>
</section>

@section Styles {
	<link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
}