@{
	if (ViewData.TryGetValue("ParentLayout", out var parentLayout)
	    && parentLayout is string layoutPath
	    && !string.IsNullOrWhiteSpace(layoutPath))
	{
		Layout = layoutPath;
	}
	else
	{
		Layout = "/Views/Shared/_Layout.cshtml";
	}
}

<section class="identity-manage-page">
	<div class="identity-manage-container">

		<header class="identity-manage-heading">
			<div class="identity-manage-mark">
				<i class="bi bi-person-gear" aria-hidden="true"></i>
			</div>

			<div>
				<h1>Manage your account</h1>
				<p>Manage your profile, password and account security.</p>
			</div>
		</header>

		<div class="row g-4">

			<aside class="col-lg-3">
				<nav class="identity-manage-sidebar" aria-label="Account settings">
					<h2 class="identity-manage-sidebar-heading">Account Settings</h2>
					<partial name="_ManageNav" />
				</nav>
			</aside>

			<div class="col-lg-9">
				<div class="identity-manage-panel">
					@RenderBody()
				</div>
			</div>

		</div>
	</div>
</section>

@section Styles {
	<link rel="stylesheet" href="~/css/identity-manage.css" asp-append-version="true" />
}

@section Scripts {
	@await RenderSectionAsync("Scripts", required: false)
}