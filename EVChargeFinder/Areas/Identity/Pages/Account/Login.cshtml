@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<section class="identity-page">
    <div class="identity-card">

        <div class="identity-header">
            <div class="identity-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>

            <h1>Welcome Back</h1>
            <p>Sign in to your EVChargeFinder account.</p>
        </div>

        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">

            <div asp-validation-summary="ModelOnly" class="identity-validation text-danger" role="alert"></div>

            <div class="identity-field">
                <label asp-for="Input.Email" class="form-label">Email Address</label>
                <div class="identity-input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="identity-field">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <div class="identity-input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check identity-remember">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button id="login-submit" type="submit" class="btn identity-submit">
                <i class="bi bi-box-arrow-in-right"></i>
                Log In
            </button>

            <div class="identity-footer">
                <span>Don't have an account?</span>
                <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create Account</a>
            </div>

        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
}